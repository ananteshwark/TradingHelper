[Unit]
Description=Run paper-call analytics on the local mirror and send the aggregate report
Requires=tradinghelper-research-db.service
After=tradinghelper-research-db.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/TradingHelper
ExecStart=%h/TradingHelper/.venv/bin/python -m igs.hybrid_analytics local --host root@95.135.254.85
TimeoutStartSec=3h
UMask=0077
Nice=10
NoNewPrivileges=true
